---
layout: null
---
{
  "blog": {{ site.url | jsonify }},
  "title": {{ site.title | jsonify }},
  "updated": {{ site.time | date: "%Y-%m-%dT%H:%M:%S%z" | jsonify }},
  "posts": [
  {% for post in site.posts %}
    {
      "title": {{ post.title | jsonify }},
      "slug": {{ post.slug | jsonify }},
      "url": {{ post.url | jsonify }},
      "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
      "tags": {{ post.tags | default: [] | jsonify }},
      "raw": {{ "https://raw.githubusercontent.com/nicokickcpython/nicokickcpython.github.io/main/" | append: post.path | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
  ]
}
